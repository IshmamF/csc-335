#lang eopl

(define-datatype stack stack?
  (empty-stack)
  (non-empty-stack
   (top symbol?)
   (rest stack?)))

(define push
  (lambda (new s)
    (non-empty-stack new s)))

(define pop
  (lambda (s)
    (cases stack s
      (empty-stack () #f)
      (non-empty-stack (top rest) rest))))

(define top
  (lambda (s)
    (cases stack s
      (empty-stack () #f)
      (non-empty-stack (top rest) top))))

